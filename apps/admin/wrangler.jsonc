{
  "name": "swanyo-admin",
  "main": "worker.ts",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "404-page"
  },
  "services": [
    {
      "binding": "API",
      "service": "swanyo-api"
    }
  ],
  "dev": {
    "ip": "127.0.0.1",
    "port": 8792
  }
}
