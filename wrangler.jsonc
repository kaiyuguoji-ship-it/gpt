{
  "name": "gpt",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "server/index.ts",
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
