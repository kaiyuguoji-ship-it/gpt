{
  "name": "swanyo-os",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @swanyo/web",
    "dev:admin": "npm run dev -w @swanyo/admin -- --port 3001",
    "dev:api": "npm run dev -w @swanyo/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "deploy:check": "npm run deploy:check --workspaces --if-present",
    "deploy:web": "npm run deploy -w @swanyo/web",
    "deploy:admin": "npm run deploy -w @swanyo/admin",
    "deploy:api": "npm run deploy -w @swanyo/api",
    "preview": "node scripts/preview.mjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "serve": "^14.2.6",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "wrangler": "4.157.0"
  },
  "type": "module",
  "packageManager": "npm@11.19.1"
}
